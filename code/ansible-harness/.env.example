# AnsibleHarness 환경변수 예시 (.env)
#
# 원칙:
# - 운영/배포 설정은 "한 파일"에서만 관리합니다(서버에서는 보통 /opt/ansible-harness/shared/.env).
# - docker compose 실행 시 항상 --env-file로 이 파일을 명시 로드합니다.
#
# 참고: NEXT_PUBLIC_API_URL은 프론트 "빌드 시점" 변수입니다.
# 운영에서는 보통 비워두고(=상대경로 /api/* + Next 프록시 사용) localhost/IP 실수를 방지합니다.

# --- DB ---
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# --- Backend ---
# 컨테이너 내부 기준으로는 기본값(/ansible, *)이면 충분한 경우가 많습니다.
ANSIBLE_DATA_DIR=/ansible
CORS_ORIGINS=*

# --- Frontend Proxy (Next server-side) ---
# 컨테이너 네트워크 기준으로 backend 서비스에 접근
BACKEND_URL=http://backend:8000

# --- Frontend Browser API Base (optional) ---
# 운영 권장: 비워두기 (프론트는 /api/* 상대경로만 사용)
NEXT_PUBLIC_API_URL=

# --- AI / RAG (Ollama OpenAI-compatible) ---
# 예: http://192.0.2.238:11434/v1
AI_BASE_URL=http://192.0.2.238:11434/v1
AI_CHAT_MODEL=gemma4:e4b
AI_EMBEDDING_MODEL=ibm/granite-embedding:278m

# 네트워크 상태에 따라 늘릴 수 있음(초 단위)
AI_TIMEOUT_SECONDS=300

# 검색 튜닝
AI_RETRIEVAL_K=3
AI_RETRIEVAL_FETCH_K=20

# --- NVIDIA AI (hosted chat-only, phase 1) ---
NVIDIA_AI_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_AI_API_KEY=
NVIDIA_AI_CHAT_MODEL=nvidia/minimaxai/minimax-m2.7 meta/llama-3.3-70b-instruct
NVIDIA_AI_TIMEOUT_SECONDS=120
